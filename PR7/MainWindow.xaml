<Window x:Class="PR7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PR7"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="31*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="21*"/>
            <RowDefinition Height="125*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="622*"/>
            <ColumnDefinition Width="141*"/>
        </Grid.ColumnDefinitions>
        <Label Content="окружность" FontWeight="Bold" FontSize="16" Margin="10,10,10,10" Grid.Column="1"/>
        <TextBox Name="ForX" Grid.Column="1" Margin="10,10,10,10" Grid.Row="1" Text="X координаты:" Foreground="LightGray" FontSize="14" Grid.ColumnSpan="2"/>
        <TextBox Name="ForY" Grid.Column="1" Margin="10,10,10,10" Grid.Row="2" Text="У координаты:" Foreground="LightGray" FontSize="14" Grid.ColumnSpan="2"/>
        <TextBox Name="Radiys" Grid.Column="1" Margin="10,10,10,10" Grid.Row="3" Text="Радиус:" Foreground="LightGray" FontSize="14" Grid.ColumnSpan="2"/>
    </Grid>
</Window>
